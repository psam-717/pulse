# Pulse backend — environment reference (values are EXAMPLES, never commit real secrets)

# Hosted platforms (Render/Neon): set these as service env vars.
DB_URL=jdbc:postgresql://localhost:5432/pulse_db
DB_USERNAME=postgres
DB_PASSWORD=your_password
JWT_SECRET=generate-a-long-random-string

# Local dev:
# 1. Create src/main/resources/application-local.properties (gitignored) with:
#    spring.datasource.password=<your local postgres password>
#    jwt.secret=<your local jwt secret>
# 2. The app auto-activates the `local` profile (spring.profiles.active=local).
#    No other setup needed for `start.bat` / `mvnw spring-boot:run`.
